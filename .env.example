# Compose infrastructure
POSTGRES_DB=eva
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_PORT=5432
BACKEND_PORT=5000
FRONTEND_PORT=5173

# Browser-facing URLs. Keep localhost when opening the app on this machine.
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000

# Required for real agent responses
LLM_GATEWAY_URL=https://litellm-gateway.delightfulpebble-214bf13c.eastus2.azurecontainerapps.io/v1
LLM_GATEWAY_API_KEY=
LLM_MODEL_ID=gpt-5-nano

# Optional integrations
BRAVE_SEARCH_API_KEY=

# Fast local startup. Use "hf" to download and use the configured transformer.
EMBED_METHOD=numpy

# Replace for any shared or long-lived environment.
JWT_SECRET=change-this-local-jwt-secret
