# Copy this file to `.env` and fill in real values. `.env` is loaded by
# src/config.py on startup. Values below are read into src.config.Settings;
# uncomment and edit the ones you need to override.

# ── Postgres (users, chats, messages, prefs, memory, mcp, checkpoints) ─────
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

# ── LLM Gateway (LiteLLM / Foundry, OpenAI-compatible) ──────────────────────
LLM_GATEWAY_URL=https://litellm-gateway.delightfulpebble-214bf13c.eastus2.azurecontainerapps.io/v1
LLM_GATEWAY_API_KEY=
LLM_MODEL_ID=gpt-5-nano

# ── LLM call logging / mock replay ───────────────────────────────────────────
# Every call through src/models/llm_client.py is recorded in full (real token
# usage + gateway-reported cost) to logs/llm/{chat_id}.jsonl and the `llm_calls`
# Postgres table. Run `python scripts/db_setup.py` once to create the table.
LLM_CALL_LOG_ENABLED=true
LLM_CALL_LOG_TO_DB=true
# When true, an identical earlier call (same model + system prompt + prompt +
# output_type + temperature) is replayed from `llm_calls` instead of hitting the
# gateway. A cache miss just falls through to a real call.
MOCK_LLM_CALL=false

# ── Embeddings (local) ───────────────────────────────────────────────────────
# EMBED_METHOD: "hf" (sentence-transformers, downloaded locally) or "numpy"
# (dependency-free hashing vectorizer)
EMBED_METHOD=hf
EMBED_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIMENSIONS=384

# ── Tools ────────────────────────────────────────────────────────────────────
BRAVE_SEARCH_API_KEY=

# ── Agent behaviour ──────────────────────────────────────────────────────────
AGENT_LOG_ENABLED=true
MAX_SUBAGENT_CALLS_PER_TURN=1
MAX_LOOPS=50

# ── Experience / learner ─────────────────────────────────────────────────────
EXPERIENCE_ENABLED=true
EXPERIENCE_IDLE_SECONDS=120
EXPERIENCE_POLL_SECONDS=20.0
EXPERIENCE_TOP_K=5

# ── Process ──────────────────────────────────────────────────────────────────
SKIP_VENV_REEXEC=false
